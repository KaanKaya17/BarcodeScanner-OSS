<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nutritionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRescan"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/btn_rescan"
            app:icon="@drawable/ic_back"
            app:iconGravity="textStart" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/productPhoto"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/photo_card"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                    android:textColor="@color/scanner_text" />

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/scanner_muted"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvBarcode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/scanner_muted" />

                <TextView
                    android:id="@+id/tvSaved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/scanner_accent"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/inset_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/scanner_text" />

            <TextView
                android:id="@+id/tvConflict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/scanner_accent"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChooseSource"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/select_source"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditLabel"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/label_open" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavorite"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/favorite_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/share_product" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/portionField"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/portion_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/portion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="5"
                android:minHeight="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvNutritionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/scanner_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/surface_card"
            android:paddingVertical="4dp"
            android:orientation="vertical">

            <LinearLayout style="@style/NutritionRow">
                <TextView style="@style/NutritionLabel" android:text="@string/label_calories" />
                <TextView android:id="@+id/tvCalories" style="@style/NutritionValue" />
            </LinearLayout>

            <LinearLayout style="@style/NutritionRow">
                <TextView style="@style/NutritionLabel" android:text="@string/label_protein" />
                <TextView android:id="@+id/tvProtein" style="@style/NutritionValue" />
            </LinearLayout>

            <LinearLayout style="@style/NutritionRow">
                <TextView style="@style/NutritionLabel" android:text="@string/label_fat" />
                <TextView android:id="@+id/tvFat" style="@style/NutritionValue" />
            </LinearLayout>

            <LinearLayout style="@style/NutritionRow">
                <TextView style="@style/NutritionLabel" android:text="@string/label_carbs" />
                <TextView android:id="@+id/tvCarbs" style="@style/NutritionValue" />
            </LinearLayout>

            <LinearLayout style="@style/NutritionRow">
                <TextView style="@style/NutritionLabel" android:text="@string/label_sugar" />
                <TextView android:id="@+id/tvSugar" style="@style/NutritionValue" />
            </LinearLayout>

            <LinearLayout style="@style/NutritionRow">
                <TextView style="@style/NutritionLabel" android:text="@string/label_fiber" />
                <TextView android:id="@+id/tvFiber" style="@style/NutritionValue" />
            </LinearLayout>

            <LinearLayout style="@style/NutritionRow">
                <TextView style="@style/NutritionLabel" android:text="@string/label_salt" />
                <TextView android:id="@+id/tvSalt" style="@style/NutritionValue" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/nutrition_note_generic"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/scanner_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSource"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/source_link_generic" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLabelPhoto"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/source_label_photo"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAttribution"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/source_fatsecret_credit"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProviderTerms"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/source_fatsecret_terms"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
